# ==========================================
# GIGFLOW CORE APPLICATION RUNTIME SETTINGS
# ==========================================
NODE_ENV=production
PORT=3000
APP_SECRET_KEY=YOUR_HEX_ENCRYPTED_SIGNING_KEY_32_BYTES

# ENGINE DATA PERSISTENCE BOUNDARIES
DATABASE_URL=postgresql://db_user:secure_password@127.0.0.1:5432/gigflow_prod?schema=public
DB_POOL_MAX=20

# TELEMETRY AND ALERTS CHANNEL MATRIX
LOG_LEVEL=info
WATCHDOG_ALERT_URI=https://api.notification-hub.internal/v1/alerts
